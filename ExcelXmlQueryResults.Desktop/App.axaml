<Application
    x:Class="ExcelXmlQueryResults.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#0B1020" />
      <Setter Property="Foreground" Value="#E6EEF8" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111933" />
      <Setter Property="BorderBrush" Value="#223056" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBox, ComboBox, ListBox, CheckBox, Button">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3E8BFF" />
      <Setter Property="Foreground" Value="#041226" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#1A2546" />
    </Style>
  </Application.Styles>
</Application>
